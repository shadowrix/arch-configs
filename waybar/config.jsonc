{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,
    "spacing": 0,
    "fixed-center": true,
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "hyprland/language", "bluetooth", "custom/vpn", "network", "cpu", "memory", "battery", "tray"],
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "all-outputs": false
    },
    "hyprland/window": {
        "max-length": 50
    },
    "battery": {
    	"interval": 60,
    	"format": "{capacity}% {icon}",
    	"format-icons": {
        	"default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        	"charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    	}
    },
    "custom/vpn": {
	    "on-click": "~/.config/waybar/scripts/vpn-toggle.sh",
	    "exec": "~/.config/waybar/scripts/vpn-status.sh",
	    "return-type": "json",
	    "interval": 5
    },
    "cpu": {
    	"interval": 10,
    	"format": "{}% ",
    	"max-length": 10
    },
    "memory": {
    	"interval": 30,
    	"format": "{}% ",
    	"max-length": 10
    },
    "network": {
	"format-wifi": " ",
	"tooltip-format": "  {essid}",
    	"format-ethernet": "󰈀",
	"format-disconnected": "󰖪",
    	"tooltip": true,
	"on-click": "nm-connection-editor"
    },
    "clock": {
        "format": "{:%H:%M}  ",
        "format-alt": "{:%a, %d %b · %H:%M}  ",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
                    "mode"          : "month",
                    "on-scroll"     : 1,
                    "format": {
                              "months":     "<span color='#c0caf5'><b>{}</b></span>",
                              "days":       "<span color='#a9b1d6'><b>{}</b></span>",
                              "weeks":      "<span color='#7dcfff'><b>W{}</b></span>",
                              "weekdays":   "<span color='#bb9af7'><b>{}</b></span>",
                              "today":      "<span color='#7aa2f7'><b><u>{}</u></b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    }
    },
    "hyprland/language": {
	    "format": "{short}"
    },
    "bluetooth": {
	"format": " {num_connections}",
	"format-disabled": "", // an empty format will hide the module
	"format-connected": " {num_connections}",
	"tooltip-format": "{controller_alias}\t{controller_address}",
	"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	"on-click": "blueman-manager"
    },
    "pulseaudio": {
	    "format": "{volume}% {icon}",
	    "format-bluetooth": "{volume}% {icon}",
	    "format-muted": "",
	    "format-icons": {
		    "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
		    "headphone": "",
		    "phone": "",
		    "phone-muted": "",
		    "portable": "",
		    "car": "",
		    "default": ["", ""]
	    },
	    "scroll-step": 1,
	    "on-click": "pavucontrol",
	    "ignored-sinks": ["Easy Effects Sink"]
    }
}
